[Unit]
Description=EV3 menu (controle por gamepad)
# Sobe logo no comeco do boot: so espera o disco e os dispositivos (udev).
# Rede, Bluetooth e o resto do sistema continuam subindo por baixo.
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Wants=systemd-udev-trigger.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
# roda como root: precisa parear Bluetooth, mexer na rede e desligar
User=root
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/robot
# prioridade maior que o resto do boot, para o menu abrir mais rapido
Nice=-10
ExecStartPre=-/bin/systemctl --no-block stop brickman.service
ExecStart=/home/robot/start_main.sh
# volta sozinho se parar por qualquer motivo
Restart=always
RestartSec=3

[Install]
WantedBy=sysinit.target
